---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Assistant from '../components/Assistant.astro';
import { brand, site, imageFor } from '../lib/content';

interface Props {
  title: string;
  description: string;
  page: 'home' | 'work' | 'about';
}
const { title, description, page } = Astro.props;

const canonical = new URL(Astro.url.pathname === '/' ? '/' : Astro.url.pathname, Astro.site);
const ogSrc = imageFor('assets/photos/lime-portrait.png');
const og = ogSrc ? await getImage({ src: ogSrc, width: 1200, format: 'jpg', quality: 82 }) : null;
const ogUrl = og ? new URL(og.src, Astro.site).href : undefined;

// Brand colors live in brand/brand.json; editing that file restyles the site.
const brandVars = [
  `--bg:${brand.bg}`,
  `--surface:${brand.surface}`,
  `--text:${brand.text}`,
  `--muted:${brand.muted}`,
  `--accent:${brand.accent}`,
  `--accent-ink:${brand.accent_text}`,
].join(';');
---
<!doctype html>
<html lang="en" style={brandVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content={brand.bg} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {og && <meta property="og:image:width" content={String(og.attributes.width ?? 1200)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogUrl && <meta name="twitter:image" content={ogUrl} />}

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      name: site.brand,
      founder: site.owner,
      description: site.subline,
      areaServed: 'Worldwide',
      address: site.location,
      sameAs: [site.links.instagram, site.links.linkedin],
      url: Astro.site?.href,
    })} />

    <!-- Netlify Identity: only loaded when arriving from a CMS invite / password reset link -->
    <script is:inline>
      if (/(invite|recovery|confirmation|email_change)_token=/.test(location.hash)) {
        var s = document.createElement('script');
        s.src = 'https://identity.netlify.com/v1/netlify-identity-widget.js';
        s.onload = function () {
          window.netlifyIdentity.on('init', function (u) { if (!u) window.netlifyIdentity.on('login', function () { location.href = '/admin/'; }); });
        };
        document.head.appendChild(s);
      }
    </script>
  </head>
  <body data-page={page}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Assistant />
  </body>
</html>
