---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site, workItems, workTypes, aiVideo, allLimit, filterFor, slugify } from '../lib/content';

// Filter buttons: each work type, with "AI Video" expanded into its content styles (UGC, BGC, …).
// Buttons with nothing in them are left out.
const labels = workTypes.flatMap((t) => (t === 'AI Video' ? [...aiVideo.styles.map((s) => s.code), t] : [t]));
const filters = [
  { label: 'All', value: 'all', count: workItems.length },
  ...labels.map((l) => ({ label: l, value: slugify(l), count: workItems.filter((w) => filterFor(w) === l).length })).filter((f) => f.count > 0),
];
const styleInfo = aiVideo.styles.filter((s) => workItems.some((w) => filterFor(w) === s.code));
const extra = workItems.length - allLimit;
---
<Base
  page="work"
  title={`Work | ${site.brand}`}
  description="Reels, carousels, AI video, ads and websites made for brands that want results, not just likes."
>
  <section class="container work-head">
    <p class="kicker">Selected work</p>
    <h1 class="h1">Work that <span class="lime">moves</span> people.</h1>
    <p class="lead">Reels, carousels, AI video, ads and websites made for brands that want results, not just likes.</p>
  </section>

  <section class="container" aria-label="Work samples" data-work data-limit={allLimit}>
    <div class="filters" role="toolbar" aria-label="Filter work">
      {filters.map((f) => (
        <button class="chip" type="button" data-filter={f.value} aria-pressed={f.value === 'all' ? 'true' : 'false'}>
          {f.label}<small>{f.count}</small>
        </button>
      ))}
    </div>
    <p class="sr-only" aria-live="polite" data-filter-status></p>

    {styleInfo.map((s) => (
      <div class="card style-info" data-style-info={slugify(s.code)} hidden>
        <p class="style-code" aria-hidden="true">{s.code}</p>
        <div>
          <h2 class="style-name">{s.name}</h2>
          <dl class="style-meta">
            <div><dt>Who creates it</dt><dd>{s.who}</dd></div>
            <div><dt>Best example</dt><dd>{s.example}</dd></div>
          </dl>
          <p class="style-note">{aiVideo.note}</p>
        </div>
      </div>
    ))}

    <div class="grid" id="work-grid" data-grid>
      {workItems.map((item, i) => <WorkCard item={item} index={i} />)}
    </div>

    {extra > 0 && (
      <div class="more">
        <button class="btn btn-outline" type="button" data-more aria-controls="work-grid" aria-expanded="false" hidden>
          <span data-more-label>Show more work</span><small data-more-count>+{extra}</small><Icon name="chevron-down" size={18} />
        </button>
      </div>
    )}
  </section>

  <CtaBand title="Want results like these?" />
</Base>

<style>
  .work-head { display: flex; flex-direction: column; gap: 16px; padding-top: clamp(48px, 8vw, 88px); }
  .work-head .h1 { max-width: 14ch; }
  .filters { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 36px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 22px; margin-top: 32px; align-items: start; }
  .grid[data-masonry] { grid-auto-rows: 4px; row-gap: 0; grid-auto-flow: row dense; }

  .style-info { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(16px, 3vw, 28px); align-items: start; margin-top: 28px; padding: clamp(18px, 3vw, 26px); border-radius: 22px; }
  .style-info[hidden] { display: none; }
  .style-code { font-size: clamp(2.5rem, 6vw, 3.75rem); font-weight: 800; letter-spacing: -0.03em; line-height: .9; color: var(--accent); }
  .style-name { font-size: clamp(1.25rem, 2.4vw, 1.5rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1.2; }
  .style-meta { margin-top: 10px; display: grid; gap: 6px; }
  .style-meta div { display: flex; gap: 10px; }
  .style-meta dt { flex: 0 0 10.5rem; white-space: nowrap; padding-top: 3px; color: var(--text); font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .style-meta dd { color: var(--muted); font-size: .9375rem; }
  .style-note { margin-top: 12px; font-size: .875rem; color: var(--muted); font-style: italic; }

  .more { display: flex; justify-content: center; margin-top: 36px; }
  .more .btn { gap: 10px; }
  .more small { font-size: .8125rem; font-weight: 700; opacity: .7; }
  .more [data-more][aria-expanded='true'] :global(svg) { transform: rotate(180deg); }
  [data-more][hidden] { display: none; }

  @media (max-width: 600px) {
    .style-info { grid-template-columns: 1fr; gap: 8px; }
    .style-meta div { flex-direction: column; gap: 2px; }
    .style-meta dt { flex: none; }
  }
</style>

<script>
  import { initWork } from '../scripts/work';
  const root = document.querySelector<HTMLElement>('[data-work]');
  if (root) initWork(root);
</script>
