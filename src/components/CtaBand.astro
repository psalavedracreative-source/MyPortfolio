---
import Icon from './Icon.astro';
import { site, bookingUrl, dmUrl } from '../lib/content';
interface Props { title: string; accent?: string; after?: string; text?: string; dm?: boolean }
const { title, accent, after = '', text = 'Book a free call. I reply within 24 hours.', dm = false } = Astro.props;
---
<section class="container section">
  <div class="card cta-band">
    <div>
      <h2 class="h2 cta-title">{title}{accent && <> <span class="lime">{accent}</span></>}{after}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-primary btn-lg" href={bookingUrl} target="_blank" rel="noopener">{site.cta_primary.label}<Icon name="arrow" /></a>
      {dm && <a class="btn btn-outline btn-lg" href={dmUrl} target="_blank" rel="noopener">{site.cta_dm.label}</a>}
    </div>
  </div>
</section>

<style>
  .cta-title { font-size: clamp(1.75rem, 3.6vw, 2.5rem); max-width: 20ch; }
</style>
