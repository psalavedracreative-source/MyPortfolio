---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { work, workItems, imageFor, keep, caseStudies, type ProofCard } from '../lib/content';

// Cover-flow cards: work.json → proof_coverflow, plus any work item marked "featured": true.
const featured: ProofCard[] = workItems
  .filter((w) => w.featured)
  .map((w) => {
    const [stat, ...unit] = (w.stat || '').split(' ');
    return { tag: w.type, client: w.client, cover: w.poster || w.image || w.slides?.[0] || '[cover image]', stat, unit: unit.join(' '), line: w.title };
  });
// Featured case studies come first, and link to their full story.
const studies: (ProofCard & { href?: string })[] = caseStudies
  .filter((c) => c.featured)
  .map((c) => ({
    tag: 'Case study',
    client: c.brand,
    cover: c.before_after?.after || c.proof?.[0]?.image || '[cover image]',
    stat: c.results[0]?.after ?? '',
    unit: (c.results[0]?.label ?? '').toLowerCase(),
    line: c.headline,
    href: `/work/${c.slug}`,
  }));
// With drafts hidden, cards still holding [PLACEHOLDERS] (other than a missing cover image) are left out.
const cards = [...studies, ...work.proof_coverflow, ...featured]
  .filter((c) => keep([c.tag, c.client, c.stat, c.unit, c.line]))
  .map((c, i) => ({ ...c, i, img: imageFor(c.cover), href: (c as { href?: string }).href }));

// No finished cards (drafts hidden and nothing filled in yet): the cover links to the Work page instead.
const Cover = cards.length ? 'button' : 'a';
const coverAttrs: Record<string, string> = cards.length ? { type: 'button', 'data-open': '' } : { href: '/work' };

// Card looks cycle through the prototype's five styles.
const looks = [
  { bg: 'var(--accent)', fg: 'var(--accent-ink)', bd: 'var(--accent)', tag: 'rgba(14,15,19,.12)' },
  { bg: 'var(--text)', fg: 'var(--accent-ink)', bd: 'var(--text)', tag: 'rgba(14,15,19,.08)' },
  { bg: 'var(--surface)', fg: 'var(--text)', bd: 'var(--accent)', tag: 'rgba(200,245,74,.14)' },
  { bg: '#23262f', fg: 'var(--text)', bd: 'var(--line-2)', tag: 'rgba(255,255,255,.08)' },
  { bg: 'var(--accent)', fg: 'var(--accent-ink)', bd: 'var(--accent)', tag: 'rgba(14,15,19,.12)' },
];

// Zoom-style reactions: heart, thumbs up, fire, star.
const ICON = {
  heart: 'M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z',
  thumb: 'M1 21h4V9H1v12zm22-11c0-1.1-.9-2-2-2h-6.31l.95-4.57.03-.32c0-.41-.17-.79-.44-1.06L14.17 1 7.59 7.59C7.22 7.95 7 8.45 7 9v10c0 1.1.9 2 2 2h9c.83 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73v-2z',
  fire: 'M13.5.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z',
  star: 'M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z',
};
const KIND = [
  { d: ICON.heart, bg: '#FF4D6D' },
  { d: ICON.thumb, bg: '#3D7BFF' },
  { d: ICON.fire, bg: '#FF7A1A' },
  { d: ICON.star, bg: '#8FB82A' },
];
const bubbles = ['4%', '12%', '20%', '28%', '36%', '44%', '52%', '60%', '68%', '76%', '84%', '91%', '16%', '72%'].map((left, i) => ({
  left, ...KIND[i % 4], size: 44 + ((i * 7) % 22), dur: (5 + ((i * 1.3) % 3)).toFixed(1), delay: (-((i * 0.9) % 6)).toFixed(1),
}));
const flowBubbles = ['8%', '22%', '38%', '52%', '66%', '80%', '30%'].map((left, i) => ({
  left, ...KIND[(i + 1) % 4], size: 36 + ((i * 5) % 14), dur: (4.5 + ((i * 1.1) % 2.5)).toFixed(1), delay: (-((i * 1.1) % 5)).toFixed(1),
}));
const comments = [
  { text: 'Amazing work!', ini: 'A', bg: '#C8F54A', left: '6%' },
  { text: 'Amazing content!', ini: 'J', bg: '#FFB86B', left: '58%' },
  { text: 'This is so good', ini: 'M', bg: '#8EC5FF', left: '30%' },
  { text: 'Need this for my brand', ini: 'R', bg: '#FF9AB0', left: '64%' },
  { text: 'Saved this!', ini: 'K', bg: '#C8F54A', left: '10%' },
  { text: 'That edit though', ini: 'D', bg: '#B7A6FF', left: '44%' },
].map((c, i) => ({ ...c, dur: (9 + (i % 3)).toFixed(1), delay: (-(i * 1.7)).toFixed(1) }));
---
<section class="proof section" id="proof" aria-labelledby="proof-title" data-proof={cards.length ? '' : undefined}>
  <div class="container">
    <div class="section-head center">
      <p class="kicker">The proof</p>
      <h2 class="h2" id="proof-title">Don't take my word <span class="lime">for it.</span></h2>
      <p class="lead">Real reactions. Real numbers.</p>
    </div>

    <!-- Cover -->
    <div class="cover-wrap" data-view="cover">
      <Cover class="cover" {...coverAttrs}>
        <span class="live-badge"><span class="live-dot" aria-hidden="true"></span>LIVE · Client reactions</span>
        <span class="tap-badge" aria-hidden="true">Tap to open</span>
        <span class="reactions" aria-hidden="true">
          {bubbles.map((b) => (
            <span class="bub" style={`left:${b.left};--s:${b.size}px;--c:${b.bg};--dur:${b.dur}s;--delay:${b.delay}s`}>
              <svg viewBox="0 0 24 24"><path d={b.d} /></svg>
            </span>
          ))}
          {comments.map((c) => (
            <span class="cmt" style={`left:${c.left};--dur:${c.dur}s;--delay:${c.delay}s`}>
              <span class="cmt-av" style={`background:${c.bg}`}>{c.ini}</span>{c.text}
            </span>
          ))}
        </span>
        <span class="cover-body">
          <span class="cover-title">Content people<br />can't <span class="lime">scroll past.</span></span>
          <span class="btn btn-primary btn-lg see-btn">See the work<Icon name="arrow" /></span>
        </span>
      </Cover>
    </div>

    <!-- Cover flow (left out when there are no finished cards to show) -->
    {cards.length > 0 && <div class="flow" data-view="flow" hidden>
      <button class="btn btn-outline btn-sm back-btn" type="button" data-close><Icon name="arrow-left" />Back</button>

      <div class="stage" tabindex="0" role="region" aria-roledescription="carousel" aria-label="Project results. Use the left and right arrow keys to browse." data-stage>
        {cards.map((c) => {
          const look = looks[c.i % looks.length];
          return (
            <button
              class:list={['fcard', { 'has-img': !!c.img }]}
              type="button"
              data-card={c.i}
              aria-label={`Show project ${c.i + 1}: ${c.tag}`}
              style={`--cbg:${look.bg};--cfg:${look.fg};--cbd:${look.bd};--ctag:${look.tag}`}
            >
              {c.img && <Picture src={c.img} alt="" widths={[300, 600]} sizes="300px" formats={['avif', 'webp']} class="fcard-img" loading="lazy" />}
              <span class="fcard-inner">
                <span class="fcard-tag">{c.tag}</span>
                {!c.img && <span class="fcard-num" aria-hidden="true">{String(c.i + 1).padStart(2, '0')}</span>}
                <span class="fcard-meta">
                  <span class="fcard-client">{c.client}</span>
                  {!c.img && <span class="fcard-note">{c.cover}</span>}
                </span>
              </span>
            </button>
          );
        })}
        <span class="flow-reactions" aria-hidden="true">
          {flowBubbles.map((b) => (
            <span class="bub" style={`left:${b.left};--s:${b.size}px;--c:${b.bg};--dur:${b.dur}s;--delay:${b.delay}s`}>
              <svg viewBox="0 0 24 24"><path d={b.d} /></svg>
            </span>
          ))}
        </span>
      </div>

      <div class="captions" aria-live="polite">
        {cards.map((c) => (
          <div class="cap" data-cap={c.i} aria-hidden="true">
            <p class="cap-stat"><span class="lime">{c.stat}</span> <span class="cap-unit">{c.unit}</span></p>
            <p class="cap-line">{c.line}</p>
            {c.href && <a class="cap-link" href={c.href}>Read the case study<Icon name="arrow" size={18} /></a>}
          </div>
        ))}
      </div>

      <div class="flow-nav">
        <button class="nav-arrow prev" type="button" data-prev aria-label="Previous project"><Icon name="chevron-left" size={22} /></button>
        <div class="dots">
          {cards.map((c) => <button class="dot" type="button" data-dot={c.i} aria-label={`Show project ${c.i + 1}`}></button>)}
        </div>
        <button class="nav-arrow next" type="button" data-next aria-label="Next project"><Icon name="chevron-right" size={22} /></button>
      </div>
    </div>}
  </div>
</section>

<style>
  .proof { overflow: hidden; }

  /* ---------- reactions ---------- */
  .reactions, .flow-reactions { position: absolute; pointer-events: none; overflow: hidden; }
  .reactions { inset: 0; z-index: 1; }
  .bub {
    position: absolute; bottom: -70px; width: var(--s); height: var(--s); border-radius: 50%;
    display: grid; place-items: center; background: var(--c);
    box-shadow: 0 10px 24px rgba(0, 0, 0, .4); opacity: 0;
    animation: rise var(--dur) ease-in var(--delay) infinite;
  }
  .bub svg { width: 54%; height: 54%; fill: #fff; }
  .cmt {
    position: absolute; bottom: -60px; display: inline-flex; align-items: center; gap: 10px;
    padding: 8px 18px 8px 8px; border-radius: 999px; background: #f4f4f0; color: #0e0f13;
    font-weight: 700; font-size: 1rem; white-space: nowrap; box-shadow: 0 10px 24px rgba(0, 0, 0, .35); opacity: 0;
    animation: riseSlow var(--dur) linear var(--delay) infinite;
  }
  .cmt-av { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; color: #0e0f13; font-size: .875rem; font-weight: 800; }
  [data-proof][data-offscreen] .bub, [data-proof][data-offscreen] .cmt { animation-play-state: paused; }
  @keyframes rise {
    0% { transform: translate(0, 0) scale(.5); opacity: 0 }
    8% { opacity: 1; transform: translate(0, -40px) scale(1) }
    50% { transform: translate(14px, -300px) scale(1) }
    85% { opacity: 1 }
    100% { transform: translate(-8px, -620px) scale(.95); opacity: 0 }
  }
  @keyframes riseSlow { 0% { transform: translateY(0); opacity: 0 } 10% { opacity: 1 } 85% { opacity: 1 } 100% { transform: translateY(-600px); opacity: 0 } }

  /* ---------- cover ---------- */
  .cover-wrap { max-width: 1000px; margin: 0 auto; }
  .cover {
    position: relative; display: block; width: 100%; height: clamp(420px, 56vw, 540px);
    border: var(--border); border-radius: 32px; background: var(--surface); color: var(--text);
    text-align: left; padding: 0; overflow: hidden; cursor: pointer;
    transition: border-color .3s;
  }
  .cover:hover { border-color: var(--line-2); }
  .live-badge, .tap-badge {
    position: absolute; top: 20px; z-index: 3; display: inline-flex; align-items: center; gap: 10px;
    background: var(--bg); border-radius: 999px; padding: 9px 15px; font-size: .8125rem; font-weight: 700; letter-spacing: .04em;
  }
  .live-badge { left: 20px; }
  .tap-badge { right: 20px; color: var(--muted); font-weight: 600; }
  .live-dot { width: 10px; height: 10px; border-radius: 50%; background: #ff4d5e; animation: pulse 1.6s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: .35 } }
  .cover-body { position: absolute; inset: 0; z-index: 2; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24px; text-align: center; padding: 0 24px; pointer-events: none; }
  .cover-title { font-size: clamp(2.125rem, 5vw, 3.75rem); font-weight: 800; letter-spacing: -0.035em; line-height: 1.02; text-shadow: 0 4px 24px rgba(14, 15, 19, .85); }
  .cover:hover .see-btn :global(svg) { transform: translateX(4px); }

  /* ---------- flow ---------- */
  .flow { display: flex; flex-direction: column; align-items: center; }
  .flow[hidden] { display: none; }
  .back-btn { align-self: flex-start; }
  .stage { --u: 1px; position: relative; width: 100%; height: calc(var(--u) * 470); margin-top: 32px; perspective: 1400px; touch-action: pan-y; border-radius: var(--r-md); }
  .stage:focus-visible { outline: 2px solid color-mix(in srgb, var(--accent) 45%, transparent); outline-offset: 8px; }
  .fcard {
    position: absolute; left: 50%; top: 0; width: calc(var(--u) * 280); height: calc(var(--u) * 360); margin-left: calc(var(--u) * -140);
    border: 2px solid var(--cbd); border-radius: 24px; padding: 0; overflow: hidden; cursor: pointer;
    background: var(--cbg); color: var(--cfg); text-align: left;
    transform: var(--t); z-index: var(--z); opacity: var(--o);
    transition: transform .65s var(--ease), opacity .45s ease;
    -webkit-box-reflect: below 8px linear-gradient(transparent 72%, rgba(255, 255, 255, .16));
    box-shadow: 0 30px 60px rgba(0, 0, 0, .5);
  }
  .fcard[data-hidden] { pointer-events: none; }
  .fcard-img, .fcard-img :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .fcard.has-img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(14,15,19,.85), transparent 55%); }
  .fcard.has-img { --cfg: var(--text); }
  .fcard-inner { position: absolute; inset: 0; z-index: 1; display: flex; flex-direction: column; justify-content: space-between; padding: calc(var(--u) * 24); }
  .fcard-tag { align-self: flex-start; background: var(--ctag); border-radius: 999px; padding: 7px 13px; font-size: .8125rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .fcard.has-img .fcard-tag { background: rgba(14,15,19,.7); }
  .fcard-num { font-size: calc(var(--u) * 120); font-weight: 900; line-height: .9; color: transparent; -webkit-text-stroke: 2px var(--cfg); }
  .fcard-meta { display: flex; flex-direction: column; gap: 4px; }
  .fcard-client { font-size: 1.25rem; font-weight: 800; }
  .fcard-note { font-size: .8125rem; font-weight: 500; opacity: .7; }
  .fcard:focus-visible { outline-offset: 4px; }
  .flow-reactions { left: 50%; top: -20px; width: calc(var(--u) * 340); margin-left: calc(var(--u) * -170); height: calc(var(--u) * 400); z-index: 30; }

  .captions { position: relative; width: 100%; max-width: 720px; height: 150px; margin-top: 8px; }
  .cap { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; opacity: 0; transform: translateY(14px); transition: opacity .45s ease, transform .45s ease; }
  .cap:not([data-on]) { visibility: hidden; }
  .cap[data-on] { opacity: 1; transform: none; }
  .cap-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--accent); font-weight: 700; text-decoration: none; }
  .cap-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .cap-stat { font-size: clamp(2.75rem, 6vw, 4.5rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1; }
  .cap-unit { font-size: .5em; letter-spacing: -0.02em; }
  .cap-line { font-size: clamp(1.125rem, 2.2vw, 1.5rem); color: var(--text-2); font-weight: 500; }

  .flow-nav { display: flex; align-items: center; gap: 24px; margin-top: 16px; }
  .nav-arrow { width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; cursor: pointer; border: 2px solid var(--accent); background: transparent; color: var(--accent); transition: background .2s, color .2s; }
  .nav-arrow.next { background: var(--accent); color: var(--accent-ink); }
  .nav-arrow.prev:hover { background: rgba(200, 245, 74, .12); }
  .nav-arrow.next:hover { background: var(--accent-hover); }
  .dots { display: flex; align-items: center; gap: 8px; }
  .dot { width: 12px; height: 12px; border-radius: 999px; border: 0; padding: 0; background: var(--line-2); cursor: pointer; transition: width .3s ease, background .3s ease; position: relative; }
  .dot::after { content: ''; position: absolute; inset: -16px -4px; }
  .dot[aria-current='true'] { width: 32px; background: var(--accent); }

  @media (max-width: 700px) {
    .stage { --u: .72px; }
    .cmt { font-size: .875rem; }
    .tap-badge { display: none; }
    .flow-nav { gap: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bub, .cmt { display: none; }
    .fcard, .cap { transition: none; }
  }
</style>

<script>
  import { initProof } from '../scripts/proof';
  document.querySelectorAll<HTMLElement>('[data-proof]').forEach(initProof);
</script>
