---
import Icon from './Icon.astro';
import { getImage } from 'astro:assets';
import { site, isPlaceholder, isRealUrl, keep, videoFor, imageFor } from '../lib/content';

type T = { quote: string; highlight?: string; name?: string; brand?: string; source?: string; platform?: string; url?: string; featured?: boolean; show?: boolean; video?: string; poster?: string };
type Badge = { platform: string; badge: string; detail: string; url: string };
const all = (site.testimonials as T[]).filter((t) => t.show !== false && t.quote?.trim() && keep(t));
const videos = await Promise.all(all.filter((t) => t.video).map(async (t) => {
  const posterImg = imageFor(t.poster);
  return { t, src: videoFor(t.video), poster: posterImg ? (await getImage({ src: posterImg, width: 640, format: 'webp' })).src : undefined };
}));
const texts = all.filter((t) => !t.video);
const badges = ((site as { platform_badges?: Badge[] }).platform_badges ?? []).filter((b) => keep([b.platform, b.badge, b.detail]));

// Split a quote around its highlighted phrase so that phrase can be set in lime.
const parts = (t: T) => {
  const h = t.highlight?.trim();
  const i = h ? t.quote.indexOf(h) : -1;
  return i < 0 ? { before: t.quote, mark: '', after: '' } : { before: t.quote.slice(0, i), mark: h!, after: t.quote.slice(i + h!.length) };
};
const who = (t: T) => [t.name, t.brand].filter((v) => v && v.trim()).join(' · ');
const initial = (t: T) => (t.name ?? '').replace(/[^A-Za-z]/g, '').charAt(0).toUpperCase();

const featured = texts.find((t) => t.featured) ?? texts[0];
const rest = texts.filter((t) => t !== featured);
const items = featured ? [{ t: featured, big: true }, ...rest.map((t) => ({ t, big: false }))] : [];
---
{(items.length > 0 || videos.length > 0) && (
  <section class="container section" aria-labelledby="love-title">
    <p class="kicker">Client feedback</p>
    <h2 class="h2" id="love-title">What clients <span class="lime">say.</span></h2>

    <ul class:list={['love', { 'has-video': videos.length > 0 }]}>
      {videos.map(({ t, src, poster }) => (
        <li class="card note vid">
          <div class="vid-media">
            {src
              ? <video src={src} poster={poster} controls playsinline preload="metadata" aria-label={`Video testimonial from ${who(t) || 'a client'}`}></video>
              : <div class="slot"><span class="vplay" aria-hidden="true"><Icon name="play" size={22} /></span>15-second client video<span class="slot-path">{t.video}</span></div>}
          </div>
          <figure>
            <blockquote><p>{t.quote}</p></blockquote>
            <figcaption>
              {who(t) && <span class="by">{who(t)}</span>}
              {t.source && <span class="src"><span class="tick" aria-hidden="true"><Icon name="check" size={13} /></span>{t.source}</span>}
            </figcaption>
          </figure>
        </li>
      ))}
      {items.map(({ t, big }) => {
        const p = parts(t);
        const by = who(t);
        return (
          <li class:list={['card note', { big }]}>
            <figure>
              <span class="mark" aria-hidden="true">“</span>
              <blockquote>
                <p>{p.before}{p.mark && <strong>{p.mark}</strong>}{p.after}</p>
              </blockquote>
              <figcaption>
                {by && !isPlaceholder(by)
                  ? <><span class="av" aria-hidden="true">{initial(t) || 'C'}</span><span class="by">{by}</span></>
                  : null}
                {t.source && <span class="src"><span class="tick" aria-hidden="true"><Icon name="check" size={13} /></span>{t.source}</span>}
                {isRealUrl(t.url) && (
                  <a class="view" href={t.url} target="_blank" rel="noopener noreferrer">
                    {t.platform?.trim() ? `View on ${t.platform.trim()}` : 'View original review'}
                    <Icon name="external" size={15} /><span class="sr-only"> (opens in a new tab)</span>
                  </a>
                )}
              </figcaption>
            </figure>
          </li>
        );
      })}
    </ul>

    {badges.length > 0 && (
      <div class="badges">
        <p class="badges-k">Verified on</p>
        <ul>
          {badges.map((b) => {
            const inner = <><span class="b-ico" aria-hidden="true"><Icon name="award" size={18} /></span><span class="b-txt"><strong>{b.platform}</strong><span>{b.badge} · {b.detail}</span></span></>;
            return <li>{isRealUrl(b.url) ? <a class="badge-pill" href={b.url} target="_blank" rel="noopener noreferrer">{inner}<Icon name="external" size={14} /></a> : <span class="badge-pill">{inner}</span>}</li>;
          })}
        </ul>
      </div>
    )}
  </section>
)}

<style>
  .love { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 32px; }
  .note { position: relative; overflow: hidden; padding: clamp(22px, 3vw, 30px); border-radius: 26px; }
  .note figure { display: flex; flex-direction: column; height: 100%; }
  .mark { display: block; height: .5em; font-size: 4rem; font-weight: 800; line-height: .9; color: var(--accent); font-family: Georgia, 'Times New Roman', serif; }
  blockquote { flex: 1; margin-top: 18px; }
  blockquote p { color: var(--muted); font-size: 1.0625rem; line-height: 1.6; }
  blockquote strong { color: var(--text); font-weight: 700; }
  figcaption { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin-top: 22px; padding-top: 18px; border-top: var(--border); }
  .av { width: 36px; height: 36px; border-radius: 50%; background: var(--accent); color: var(--accent-ink); display: grid; place-items: center; font-weight: 800; }
  .by { font-weight: 700; }
  .src { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); font-size: .875rem; font-weight: 600; }
  .view { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; color: var(--text); font-size: .875rem; font-weight: 700; text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--accent) 60%, transparent); text-underline-offset: 4px; transition: color .2s; }
  .view:hover { color: var(--accent); }
  .tick { width: 20px; height: 20px; border-radius: 50%; background: var(--accent); color: var(--accent-ink); display: grid; place-items: center; }

  /* The featured quote spans the full width, set large, with a soft lime glow. */
  .note.big { grid-column: 1 / -1; padding: clamp(28px, 5vw, 56px); background: radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 55%), var(--surface); }
  .big .mark { font-size: clamp(4.5rem, 9vw, 7rem); }
  .note.big::after { content: '”'; position: absolute; right: clamp(8px, 4vw, 48px); bottom: -0.38em; font: 800 clamp(14rem, 30vw, 26rem)/1 Georgia, 'Times New Roman', serif; color: var(--accent); opacity: .07; pointer-events: none; }
  .big blockquote { margin-top: clamp(22px, 3vw, 34px); }
  .big blockquote p { color: var(--text); font-size: clamp(1.375rem, 3vw, 2.125rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.3; max-width: 40ch; text-wrap: pretty; position: relative; }
  .big blockquote strong { color: var(--accent); font-weight: 800; }

  /* Video testimonial sits beside the featured quote (which then takes two columns). */
  .has-video .note.big { grid-column: span 2; grid-row: 1; }
  .vid { grid-column: 3; grid-row: 1; display: flex; flex-direction: column; padding: 0; }
  .vid-media { position: relative; aspect-ratio: 4 / 5; background: var(--bg); }
  .vid-media video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vid-media .slot { position: absolute; inset: 14px; }
  .vplay { width: 52px; height: 52px; border-radius: 50%; background: var(--accent); color: var(--accent-ink); display: grid; place-items: center; padding-left: 3px; }
  .vplay :global(svg) { color: var(--accent-ink); width: 22px; height: 22px; }
  .vid-media .slot-path { font-size: .75rem; font-weight: 500; word-break: break-all; }
  .vid figure { padding: 18px 22px 22px; }
  .vid blockquote { margin-top: 0; }
  .vid blockquote p { color: var(--text); font-weight: 600; }
  .vid figcaption { margin-top: 14px; padding-top: 14px; }

  .badges { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px 18px; margin-top: 32px; }
  .badges-k { color: var(--muted); font-size: .8125rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .badges ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .badge-pill { display: inline-flex; align-items: center; gap: 12px; min-height: 56px; padding: 8px 18px 8px 10px; border-radius: 999px; border: var(--border); background: var(--surface); color: var(--text); text-decoration: none; transition: border-color .2s; }
  a.badge-pill:hover { border-color: var(--accent); }
  .b-ico { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: color-mix(in srgb, var(--accent) 16%, transparent); color: var(--accent); }
  .b-txt { display: flex; flex-direction: column; line-height: 1.25; }
  .b-txt strong { font-size: .9375rem; }
  .b-txt span { color: var(--muted); font-size: .8125rem; font-weight: 600; }

  @media (max-width: 1000px) {
    .love { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .love > :last-child:nth-child(even) { grid-column: 1 / -1; }
    .has-video .note.big { grid-column: 1 / -1; grid-row: auto; order: -1; }
    .vid { grid-column: auto; grid-row: auto; }
  }
  @media (max-width: 680px) { .love { grid-template-columns: 1fr; } }
</style>
