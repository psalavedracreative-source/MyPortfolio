---
import Icon from './Icon.astro';
import { faqItems, bookingUrl } from '../lib/content';
---
{faqItems.length > 0 && (
  <section class="container section" id="faq" aria-labelledby="faq-title">
    <div class="section-head center">
      <p class="kicker">FAQ</p>
      <h2 class="h2" id="faq-title">Questions, <span class="lime">answered.</span></h2>
    </div>
    <div class="faq">
      {faqItems.map((f, i) => (
        <details class="card qa" open={i === 0}>
          <summary><span>{f.q}</span><span class="tog" aria-hidden="true"><Icon name="plus" size={18} /></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
    <p class="more">Still have a question? <a href={bookingUrl} target="_blank" rel="noopener">Book a free call</a> or ask the chat assistant in the corner.</p>
  </section>
)}

<style>
  .faq { display: flex; flex-direction: column; gap: 12px; max-width: 820px; margin-inline: auto; }
  .qa { border-radius: 20px; overflow: hidden; }
  .qa summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 64px; padding: 16px 22px; cursor: pointer; font-size: 1.0625rem; font-weight: 700; }
  .qa summary::-webkit-details-marker { display: none; }
  .qa summary:hover { color: var(--accent); }
  .tog { flex: none; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; border: 2px solid var(--line-2); color: var(--accent); transition: transform .25s ease, background .25s, color .25s, border-color .25s; }
  .qa[open] .tog { transform: rotate(45deg); background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .qa p { padding: 0 22px 20px; color: var(--muted); font-size: 1.0625rem; line-height: 1.65; max-width: 68ch; }
  .more { margin-top: 24px; text-align: center; color: var(--muted); }
  .more a { color: var(--text); font-weight: 700; text-decoration-color: var(--accent); text-underline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) { .tog { transition: none; } }
</style>
