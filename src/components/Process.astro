---
import { site } from '../lib/content';
---
<section class="container section" id="process" aria-labelledby="process-title">
  <div class="section-head">
    <p class="kicker">How it works</p>
    <h2 class="h2" id="process-title">Simple from <span class="lime">day one.</span></h2>
  </div>
  <ol class="steps">
    {site.process.map((p, i) => (
      <li class="card step">
        <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <div>
          <h3 class="h3"><span class="sr-only">Step {i + 1}: </span>{p.step}</h3>
          <p>{p.text}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .step { display: flex; align-items: center; gap: clamp(18px, 3vw, 32px); padding: clamp(22px, 3vw, 30px); border-radius: var(--r-md); }
  .step-num { flex: none; min-width: 2.1ch; font-size: clamp(2.75rem, 5vw, 3.5rem); font-weight: 800; line-height: 1; letter-spacing: -0.02em; color: transparent; -webkit-text-stroke: 2px var(--accent); }
  .step p { color: var(--muted); margin-top: 4px; }
  @media (max-width: 760px) { .steps { grid-template-columns: 1fr; } }
</style>
