---
import { Image } from 'astro:assets';
import { site, imageFor, svgFor, isPlaceholder } from '../lib/content';

const initials = (name: string) =>
  name.replace(/([a-z])([A-Z])/g, '$1 $2').replace(/[^A-Za-z0-9 ]/g, ' ').trim().split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase();

const logos = site.client_logos.map((c) => ({
  ...c,
  img: imageFor(c.logo),
  svg: svgFor(c.logo),
  placeholder: isPlaceholder(c.name),
  initials: initials(c.name),
}));
// Duration scales with the number of logos so the drift speed stays the same.
const duration = Math.max(20, logos.length * 4.5);
---
<section class="logos" aria-labelledby="logos-title">
  <h2 id="logos-title" class="container label logos-title">Brands I've worked with</h2>
  <div class="marquee" style={`--dur:${duration}s`}>
    <div class="track">
      {[0, 1].map((copy) => (
        <ul class="logo-row" aria-hidden={copy === 1 ? 'true' : undefined}>
          {logos.map((c, i) => (
            <li class:list={['logo', { empty: c.placeholder }]} style={`--d:${(i % 5) * -0.9}s`}>
              <span class="mark">
                {c.svg ? <img src={c.svg} alt="" loading="lazy" width="64" height="64" />
                  : c.img ? <Image src={c.img} alt="" height={128} format="webp" loading="lazy" />
                  : c.placeholder ? <i class="ph" aria-hidden="true"></i>
                  : <span class="mono" aria-hidden="true">{c.initials}</span>}
              </span>
              <span class="name">{c.name}</span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .logos { padding-block: 8px clamp(56px, 8vw, 88px); overflow: hidden; }
  .logos-title { display: block; text-align: center; margin-bottom: 22px; }

  /* Sideways drift: two identical rows slide left by exactly one row, so the loop is seamless. */
  .marquee {
    position: relative;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .track { display: flex; width: max-content; animation: drift var(--dur) linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  @keyframes drift { to { transform: translateX(-50%); } }

  .logo-row { display: flex; gap: clamp(28px, 4vw, 52px); padding-right: clamp(28px, 4vw, 52px); padding-block: 10px; }
  .logo { display: flex; flex-direction: column; align-items: center; gap: 10px; width: 132px; animation: bob 5s ease-in-out infinite; animation-delay: var(--d); }
  @keyframes bob { 50% { transform: translateY(-6px); } }

  .mark { display: grid; place-items: center; height: 64px; }
  .mark img { height: 64px; width: auto; max-width: 120px; object-fit: contain; opacity: .88; transition: opacity .3s, transform .3s; }
  .logo:hover .mark img { opacity: 1; transform: scale(1.08); }
  .mono { display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%; border: 2px solid var(--line-2); color: var(--muted); font-size: 1.125rem; font-weight: 800; letter-spacing: .02em; transition: color .3s, border-color .3s; }
  .logo:hover .mono { color: var(--accent); border-color: var(--accent); }
  .ph { width: 60px; height: 60px; border-radius: var(--r-sm); border: 2px dashed var(--line-2); }

  .name { color: var(--muted); font-size: .8125rem; font-weight: 700; letter-spacing: .02em; text-align: center; line-height: 1.3; transition: color .3s; }
  .logo:hover .name { color: var(--text); }

  @media (prefers-reduced-motion: reduce) {
    .marquee { -webkit-mask-image: none; mask-image: none; }
    .track { animation: none; width: auto; justify-content: center; }
    .logo-row { flex-wrap: wrap; justify-content: center; padding-inline: 16px; row-gap: 24px; }
    .logo-row[aria-hidden] { display: none; }
    .logo { animation: none; }
  }
</style>
