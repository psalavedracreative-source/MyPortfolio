---
import { Image } from 'astro:assets';
import { site, imageFor, svgFor } from '../lib/content';
const logos = site.client_logos.map((c) => ({ ...c, img: imageFor(c.logo), svg: svgFor(c.logo) }));
---
<section class="container logos" aria-labelledby="logos-title">
  <h2 id="logos-title" class="label logos-title">Brands I've worked with</h2>
  <ul class="logo-row">
    {logos.map((c) => (
      <li class:list={['logo-cell', { empty: !c.img && !c.svg }]}>
        {c.svg ? <img src={c.svg} alt={c.name} loading="lazy" width="140" height="48" />
          : c.img ? <Image src={c.img} alt={c.name} height={48} loading="lazy" />
          : <span class="logo-ph"><i aria-hidden="true"></i>{c.name}</span>}
      </li>
    ))}
  </ul>
</section>

<style>
  .logos { padding-block: 8px clamp(56px, 8vw, 88px); }
  .logos-title { text-align: center; margin-bottom: 18px; }
  .logo-row { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
  .logo-cell { display: grid; place-items: center; min-height: 72px; padding: 12px; border-radius: var(--r-sm); }
  .logo-cell img { max-height: 44px; width: auto; filter: grayscale(1) brightness(1.6); opacity: .7; transition: filter .3s, opacity .3s; }
  .logo-cell:hover img { filter: none; opacity: 1; }
  .logo-cell.empty { border: 2px dashed var(--line-2); }
  .logo-ph { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); font-size: .875rem; font-weight: 600; }
  .logo-ph i { width: 16px; height: 16px; border-radius: 4px; background: var(--line-2); }
  @media (max-width: 760px) { .logo-row { grid-template-columns: repeat(2, minmax(0, 1fr)); } .logo-cell:last-child { grid-column: 1 / -1; } }
</style>
